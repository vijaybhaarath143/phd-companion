# Copy to .env.local for local development (values from `npx supabase start`),
# or set these in Vercel → Project → Settings → Environment Variables.

# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres connection. Hosted: Supabase → Connect → "Transaction pooler" (port 6543).
DATABASE_URL=

# Gets past every "own rows only" rule. Used by scripts/seed.mjs on your machine, and on the
# server by the Admin page only (src/server/admin.ts — a test checks nothing else reads it).
# On Vercel: add it as a server variable (never NEXT_PUBLIC_). Without it the Admin page still
# lists accounts, but can't add, pause or delete them.
SUPABASE_SECRET_KEY=

# Optional: Cloudflare Turnstile check on the sign-in form (also turn on CAPTCHA in
# Supabase → Authentication → Attack Protection with the matching secret).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: native ChatGPT subscription connection (separate from the MCP connector).
# First apply the ChatGPT migration and register this hosted app with OpenAI for plan usage.
# Keep disabled until OpenAI confirms this client can use the scopes described in docs/chatgpt-connection.md.
CHATGPT_HOSTED_PLAN_ACCESS=
CHATGPT_CLIENT_ID=
# Exact registered callback, e.g. https://your-app.example/api/chatgpt/callback
CHATGPT_REDIRECT_URI=
# Use the method provisioned by OpenAI: none or client_secret_basic.
CHATGPT_TOKEN_AUTH_METHOD=none
CHATGPT_CLIENT_SECRET=
# Server-only 32-byte AES key encoded as 64 hex characters; generate privately and keep stable.
CHATGPT_TOKEN_ENCRYPTION_KEY=
